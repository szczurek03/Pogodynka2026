{% extends 'base.html.twig' %}

{# @var place \App\Entity\Place #}
{# @var measurements \App\Entity\Measurement[] #}


{% block title %}Weather in {{ place.locality }}, {{ place.country }}{% endblock %}

{% block body %}
    <main>
        <h1>Weather in {{ place.locality }}, {{ place.country }}</h1>

        <ul>

            {% for measurement in measurements %}
                <li>{{ measurement.date|date('d.m.Y') }}: {{ measurement.temperature }}&deg;C,
                    Wind Speed: {{ measurement.WindSpeed }}km/h, Humidity: {{ measurement.humidity }}%,
                    Pressure: {{ measurement.AtmosphericPressure }}hPa </li>
            {% endfor %}
        </ul>
    </main>
{% endblock %}
